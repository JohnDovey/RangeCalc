<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d6efd" />
    <title>Range Calculator - Full Triangulation</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body { transition: background-color 0.3s; }
        .result { font-size: 2.4rem; font-weight: 700; }
        .card { background-color: #2c2c2c; }
    </style>
</head>
<body data-bs-theme="dark">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="display-5 fw-bold">Range Calculator</h1>
                        <p class="lead text-muted">Full Triangulation Edition</p>
                    </div>
                    <button id="themeToggle" class="btn btn-outline-light">🌙</button>
                </div>

                <div class="card shadow">
                    <div class="card-header bg-primary text-center py-3">
                        <h3>Calculate Range to Target</h3>
                    </div>
                    <div class="card-body">
                        <form id="rangeForm">
                            <div class="mb-3">
                                <label class="form-label">Bearing One (Ref 1)</label>
                                <input type="number" class="form-control form-control-lg" id="b1" min="1" max="360" placeholder="45" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Bearing Two (Ref 2)</label>
                                <input type="number" class="form-control form-control-lg" id="b2" min="1" max="360" placeholder="90" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Baseline Distance</label>
                                <input type="number" class="form-control form-control-lg" id="dist" min="1" placeholder="100" required>
                                <small class="text-muted">meters between Ref1 and Ref2</small>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Calculation Method</label>
                                <select class="form-select form-select-lg" id="method">
                                    <option value="1">Simple (Fast)</option>
                                    <option value="2">Full Triangulation (Accurate)</option>
                                </select>
                            </div>

                            <div id="baselineGroup" class="mb-4 d-none">
                                <label class="form-label">Baseline Bearing (Ref1 → Ref2)</label>
                                <input type="number" class="form-control form-control-lg" id="baselineBearing" min="1" max="360" placeholder="0" required>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100">Calculate</button>
                        </form>

                        <div id="resultContainer" class="mt-4 d-none">
                            <div class="card border-success">
                                <div class="card-body text-center">
                                    <h5>Results</h5>
                                    <div id="result1" class="result text-success"></div>
                                    <div id="result2" class="result text-info mt-2"></div>
                                    <small id="angle" class="text-muted"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button id="resetBtn" class="btn btn-outline-secondary w-100 mt-3">New Calculation</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const form = document.getElementById('rangeForm');
        const baselineGroup = document.getElementById('baselineGroup');
        const resultContainer = document.getElementById('resultContainer');

        // Show/hide baseline bearing field
        document.getElementById('method').addEventListener('change', function() {
            baselineGroup.classList.toggle('d-none', this.value === '1');
        });

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const b1 = parseFloat(document.getElementById('b1').value);
            const b2 = parseFloat(document.getElementById('b2').value);
            const dist = parseFloat(document.getElementById('dist').value);
            const method = document.getElementById('method').value;

            if (!b1 || !b2 || !dist) {
                alert("Please fill all required fields.");
                return;
            }

            let result;
            if (method === "2") {
                const baselineBearing = parseFloat(document.getElementById('baselineBearing').value);
                if (!baselineBearing) {
                    alert("Please enter Baseline Bearing for Full mode.");
                    return;
                }
                result = calculateFull(b1, b2, dist, baselineBearing);
            } else {
                result = calculateSimple(b1, b2, dist);
            }

            // Display results
            document.getElementById('result1').textContent = `From Ref 1: ${result.range1.toFixed(2)} m`;
            document.getElementById('result2').textContent = `From Ref 2: ${result.range2.toFixed(2)} m`;
            document.getElementById('angle').textContent = `Angle at Target: ${result.angle.toFixed(1)}°`;
            resultContainer.classList.remove('d-none');
        });

        function calculateSimple(b1, b2, dist) {
            let diff = Math.abs(b1 - b2);
            if (diff > 180) diff = 360 - diff;
            const rad = (90 - diff) * Math.PI / 180;
            const range = dist * Math.tan(rad);
            return { range1: range, range2: range, angle: diff };
        }

        function calculateFull(b1, b2, dist, baselineBearing) {
            let angleAtTarget = Math.abs(b1 - b2);
            if (angleAtTarget > 180) angleAtTarget = 360 - angleAtTarget;

            let angleAtRef1 = Math.abs(baselineBearing - b1);
            if (angleAtRef1 > 180) angleAtRef1 = 360 - angleAtRef1;

            const angleAtRef2 = 180 - angleAtTarget - angleAtRef1;

            if (angleAtRef2 <= 0) {
                alert("Invalid geometry. Check your bearings.");
                return { range1: 0, range2: 0, angle: angleAtTarget };
            }

            const sinTarget = Math.sin(angleAtTarget * Math.PI / 180);
            const range1 = dist * Math.sin(angleAtRef2 * Math.PI / 180) / sinTarget;
            const range2 = dist * Math.sin(angleAtRef1 * Math.PI / 180) / sinTarget;

            return { range1, range2, angle: angleAtTarget };
        }

        // Reset
        document.getElementById('resetBtn').addEventListener('click', () => {
            form.reset();
            resultContainer.classList.add('d-none');
            baselineGroup.classList.add('d-none');
        });

        // Theme Toggle
        document.getElementById('themeToggle').addEventListener('click', () => {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            document.documentElement.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');
            document.getElementById('themeToggle').textContent = isDark ? '☀️' : '🌙';
        });
    </script>
</body>
</html>