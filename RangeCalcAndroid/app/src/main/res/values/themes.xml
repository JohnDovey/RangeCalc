<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RangeCalc" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shown for the brief OS-level cold-start splash, before the in-app
         illustrated splash (SplashScreen.kt) takes over. -->
    <style name="Theme.RangeCalc.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rangecalc_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RangeCalc</item>
    </style>
</resources>
